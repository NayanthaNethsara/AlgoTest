ENV=production
DATABASE_URL=postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DB_MAX_CONNS=20
DB_MIN_CONNS=5

JUDGE_WORKERS=7
JUDGE_QUEUE_SIZE=128

RUN_REQUIRE_ISOLATE=true
RUN_MAX_CONCURRENT=7
RUN_RESERVE=0
RUN_CPU_LIST=1-7
RUN_MEMORY=256m
RUN_CPU_SECONDS=5
RUN_WALL_TIMEOUT_SECONDS=10
RUN_COMPILE_TIMEOUT_SECONDS=15
RUN_WORK_ROOT=/var/local/lib/algothon-work
RUN_ISOLATE_BIN=/usr/local/bin/isolate
RUN_MAX_QUEUE=16
RUN_MAX_WAIT_SECONDS=120

