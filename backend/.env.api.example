ENV=production
PORT=8080
ALLOWED_ORIGINS=https://contest.yourdomain.com,tauri://localhost,http://tauri.localhost,https://tauri.localhost
TRUSTED_PROXIES=127.0.0.1
DATABASE_URL=postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DB_MAX_CONNS=25
DB_MIN_CONNS=5

JUDGE_WORKERS=0
JUDGE_QUEUE_SIZE=64

SESSION_COOKIE_NAME=session
SESSION_TTL_HOURS=168
ENABLE_TELEMETRY=true

RUN_REQUIRE_ISOLATE=true
RUN_MAX_CONCURRENT=2
RUN_RESERVE=0
RUN_CPU_LIST=2-3
RUN_MEMORY=256m
RUN_CPU_SECONDS=2
RUN_WALL_TIMEOUT_SECONDS=6
RUN_COMPILE_TIMEOUT_SECONDS=10
RUN_WORK_ROOT=/var/local/lib/algothon-work
RUN_ISOLATE_BIN=/usr/local/bin/isolate
RUN_MAX_QUEUE=16
RUN_MAX_WAIT_SECONDS=10

