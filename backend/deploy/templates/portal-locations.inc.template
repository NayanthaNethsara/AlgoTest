# Routing shared by the venue's HTTP and TLS server blocks.
#
# The `.inc` extension matters: nginx auto-includes conf.d/*.conf, and a bare set of
# location blocks parsed at http level is a syntax error. Rendered by the nginx
# image's envsubst pass, which only substitutes names present in the environment, so
# $remote_addr and friends pass through untouched.

location /api/v1/submissions/stream {
    proxy_pass ${API_SCHEME}://contest_api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host ${API_HOST};
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Proctor-Client $proctor_client_claim;

    proxy_ssl_server_name on;
    proxy_ssl_name ${API_HOST};

    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 86400s;
    proxy_send_timeout 86400s;
}

# Carries the proctor agent's routes too: contestants have no route to the internet
# of their own.
location /api/ {
    proxy_pass ${API_SCHEME}://contest_api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host ${API_HOST};
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Proctor-Client $proctor_client_claim;

    proxy_ssl_server_name on;
    proxy_ssl_name ${API_HOST};

    proxy_read_timeout 120s;
    proxy_connect_timeout 10s;
    client_max_body_size 50m;
}

location /healthz {
    proxy_pass ${API_SCHEME}://contest_api;
    proxy_http_version 1.1;
    proxy_set_header Host ${API_HOST};
    proxy_ssl_server_name on;
    proxy_ssl_name ${API_HOST};
    access_log off;
}

location / {
    proxy_pass http://portal;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
