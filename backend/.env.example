PORT=8080
ENV=development
ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=postgres://algothon:algothon@localhost:5432/algothon?sslmode=disable
# Unset: workers track RUN_MAX_CONCURRENT minus RUN_RESERVE, so a bigger host
# needs only RUN_MAX_CONCURRENT raised. Pin a number here to run fewer judges
# than the host has sandboxes.
# JUDGE_WORKERS=2
JUDGE_QUEUE_SIZE=64

# Local auth sessions (opaque tokens stored in Postgres; no external service).
SESSION_COOKIE_NAME=session
SESSION_TTL_HOURS=168

# /api/v1/run sandboxed execution (requires Docker; run `make judge-images` once).
RUN_COMPILE_TIMEOUT_SECONDS=10
RUN_CPU_SECONDS=5             # fair compute budget, enforced via RLIMIT_CPU
RUN_WALL_TIMEOUT_SECONDS=10   # wall-clock backstop (catches sleep/blocking); keep > RUN_CPU_SECONDS
RUN_MEMORY=256m
# Docker runtime for the sandbox. Leave empty in dev; set "runsc" in prod for
# gVisor userspace-kernel isolation (install gVisor on the judge nodes first).
RUN_DOCKER_RUNTIME=

# Where per-run workspaces are created. Point this at a size-capped tmpfs --
# deploy/provision-isolate.sh sets one up at /var/local/lib/algothon-work.
# Workspaces are bind-mounted into the sandbox, so isolate's --quota does not
# bound them and --fsize caps only one file at a time; on a tmpfs the writes are
# charged to the run's own memory cgroup, so RUN_MEMORY bounds them instead.
# Empty uses the system temp dir, where a submission can fill the host disk.
RUN_WORK_ROOT=

# Per-node concurrency: cap containers running at once (size ~= vCPUs, each run
# reserves ~1 CPU), how many extra requests may wait for a slot, and how long a
# waiter blocks before returning 503 "server busy". Excess over both is rejected.
RUN_MAX_CONCURRENT=4
RUN_MAX_QUEUE=64
RUN_MAX_WAIT_SECONDS=15
