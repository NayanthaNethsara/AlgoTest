# Server-only base URL for the Go backend (never exposed to the browser).
API_URL=http://localhost:8080

# Platform execution target: 'web' (default central server) or 'desktop' (local Tauri sidecar)
NEXT_PUBLIC_PLATFORM=web

# Local code runner service URL when NEXT_PUBLIC_PLATFORM=desktop
NEXT_PUBLIC_LOCAL_RUNNER_URL=http://127.0.0.1:8081

# Set true only when the site is served over HTTPS. Wrong either way hurts: false on
# HTTPS ships an unprotected session cookie, true on the venue's plain-HTTP LAN means
# browsers discard the cookie and nobody can sign in.
COOKIE_SECURE=false

# Enable or disable competitor background activity telemetry tracking (true/false)
NEXT_PUBLIC_ENABLE_TELEMETRY=true
