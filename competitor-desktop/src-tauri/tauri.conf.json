{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "mini-algothon-competitor",
  "version": "0.1.0",
  "identifier": "com.minialgothon.competitor",
  "build": {
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm --filter competitor-frontend dev",
    "beforeBuildCommand": "pnpm --filter competitor-frontend build"
  },
  "app": {
    "windows": [
      {
        "title": "MiniAlgothon Competitor",
        "url": "http://localhost:3000",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "maximized": true,
        "fullscreen": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
