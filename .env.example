# Settings for docker-compose.venue.yml (`make venue`). Compose reads .env
# automatically; the shell and the make command line override it.
#
#   cp .env.example .env

# The cloud API, for the portal's own server-side calls.
API_URL=https://mini-algothon-api.nayantha.me

# The same host, split for the nginx relay that carries browser and proctor-agent
# traffic onward -- contestants have no route of their own.
API_HOST=mini-algothon-api.nayantha.me
API_PORT=443
API_SCHEME=https

# Competitor portal target (e.g. your live Vercel deployment URL):
# When set, the venue Nginx acts as a pure relay to Vercel without needing to
# run or build a local frontend container.
PORTAL_HOST=algothon.vercel.app
PORTAL_PORT=443
PORTAL_SCHEME=https

# Only for `make venue-tls`: the hostname on the certificate in ./certs.
# PORTAL_SERVER_NAME=contest.example.com
