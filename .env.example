# Settings for docker-compose.venue.yml (`make venue`). Compose reads .env
# automatically; the shell and the make command line override it.
#
#   cp .env.example .env

# The cloud API, for the portal's own server-side calls. HTTPS is not optional: the
# venue server reaches the backend across the public internet exactly as the hosted
# backup does, and this connection carries session tokens and contestant source code.
API_URL=https://mini-algothon-api.nayantha.me

# The same host, split for the nginx relay that carries browser and proctor-agent
# traffic onward -- contestants have no route of their own. Keep in step with
# API_URL: on port 80 these carry agent tokens and telemetry in cleartext.
API_HOST=mini-algothon-api.nayantha.me
API_PORT=443
API_SCHEME=https

# Only for `make venue-tls`: the hostname on the certificate in ./certs. A bare LAN
# IP cannot be certificated, so TLS at the venue needs a name contestants resolve.
# PORTAL_SERVER_NAME=contest.example.com
