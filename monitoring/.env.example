# Settings for monitoring/docker-compose.monitoring.yml. Compose reads
# monitoring/.env automatically; the shell and the make command line override it.
#
#   cp monitoring/.env.example monitoring/.env
#
# Never commit monitoring/.env -- .gitignore covers it, and this repository is
# public.

# Grafana runs only on 127.0.0.1, behind the "local" compose profile, so it never
# starts on the deployed VM and these defaults are fine on your own machine. Set a
# real password before binding Grafana to anything other than loopback.
#
# GF_SECURITY_ADMIN_PASSWORD is read only when Grafana first initialises its
# database -- on an instance that already exists it is ignored. To rotate it:
#   docker exec algothon-grafana grafana-cli admin reset-admin-password '<password>'
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Host port for Grafana, published on 127.0.0.1 only. Change if 3002 is taken.
GRAFANA_PORT=3002

# Datasource URLs, interpolated into grafana/provisioning/datasources/datasources.yml
# at startup. Left unset they default to the in-stack service names
# (http://prometheus:9090 and http://loki:3100), which is what you want whenever the
# whole stack runs together.
#
# `make grafana-remote` sets these to read the deployed VM's data through the tunnel
# from `make monitoring-tunnel`, so you should not normally set them by hand.
# Environment variables are fixed when a container is created, so change them with
# `docker compose up -d --force-recreate grafana`, not a plain restart.
# See docs/monitoring.md.
#
# PROMETHEUS_URL=http://host.docker.internal:19090
# LOKI_URL=http://host.docker.internal:13100
